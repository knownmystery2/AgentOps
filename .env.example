# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
GEMINI_API_KEY=placeholder_gemini_api_key

# GITHUB_TOKEN: GitHub Personal Access Token for automated repository deployments and Pages hosting.
GITHUB_TOKEN=placeholder_github_token

# STRIPE_SECRET_KEY: Stripe Secret Key for creating automated checkout payment links.
STRIPE_SECRET_KEY=placeholder_stripe_secret_key

# STRIPE_PUBLISHABLE_KEY: Stripe Publishable Key for client-side payment verification.
STRIPE_PUBLISHABLE_KEY=placeholder_stripe_publishable_key
