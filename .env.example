# GEMINI_API_KEY: Required for Gemini AI API calls (Free tier: gemini-2.5-flash).
GEMINI_API_KEY=your_gemini_api_key_here

# HF_TOKEN: Hugging Face Inference API token (Free tier: FLUX.1-schnell or stable-diffusion-xl-base-1.0).
HF_TOKEN=your_huggingface_token_here

# GITHUB_TOKEN: GitHub Personal Access Token for free GitHub Pages deployment.
GITHUB_TOKEN=your_github_token_here

# PRINTIFY_API_TOKEN: Printify API token (Free plan: 0 monthly fee).
PRINTIFY_API_TOKEN=your_printify_api_token_here

# STRIPE_SECRET_KEY: Stripe Secret Key for payment settlement (Free test mode).
STRIPE_SECRET_KEY=sk_test_placeholder

# STRIPE_PUBLISHABLE_KEY: Stripe Publishable Key for client payments.
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder

# Client browser build environment variables (React):
REACT_APP_HF_TOKEN=your_huggingface_token_here
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
